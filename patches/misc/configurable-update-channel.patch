Subject: Make update channel configurable via build config

---
 TMessagesProj/build.gradle | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -147,6 +147,8 @@ android {
             buildConfigField "boolean", "DEBUG_PRIVATE_VERSION", "true"
             buildConfigField "boolean", "BUNDLE", "false"
             buildConfigField "boolean", "BUILD_HOST_IS_WINDOWS", isWindows
+            buildConfigField "String", "UPDATE_CHANNEL_USERNAME", "\"" + (System.getenv('UPDATE_CHANNEL_USERNAME') ?: 'InugramCI') + "\""
+            buildConfigField "long", "UPDATE_CHANNEL_ID", (System.getenv('UPDATE_CHANNEL_ID') ?: '3968318575L')
         }
 
         release {
@@ -164,6 +166,8 @@ android {
             buildConfigField "boolean", "DEBUG_PRIVATE_VERSION", "false"
             buildConfigField "boolean", "BUNDLE", "false"
             buildConfigField "boolean", "BUILD_HOST_IS_WINDOWS", isWindows
+            buildConfigField "String", "UPDATE_CHANNEL_USERNAME", "\"" + (System.getenv('UPDATE_CHANNEL_USERNAME') ?: 'InugramCI') + "\""
+            buildConfigField "long", "UPDATE_CHANNEL_ID", (System.getenv('UPDATE_CHANNEL_ID') ?: '3968318575L')
         }
